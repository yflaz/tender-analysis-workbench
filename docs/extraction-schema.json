{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TenderAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "commercial",
    "technical_requirements",
    "schedule",
    "compliance",
    "risks",
    "outsourcing_candidates",
    "summary",
    "source_references"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "industry", "bid_deadline", "document_language"],
      "properties": {
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "industry": { "type": "string", "enum": ["石油化工", "煤化工", "天然气", "电力", "其他"] },
        "bid_deadline": { "type": ["string", "null"], "description": "ISO 8601 date or datetime when possible." },
        "document_language": { "type": "string" }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_price", "currency", "payment_terms", "bond", "warranty", "tax_terms"],
      "properties": {
        "total_price": { "type": ["number", "null"], "description": "Amount in ten-thousand CNY when available." },
        "currency": { "type": "string" },
        "payment_terms": { "type": "array", "items": { "type": "string" } },
        "bond": { "type": ["string", "null"] },
        "warranty": { "type": ["string", "null"] },
        "tax_terms": { "type": ["string", "null"] }
      }
    },
    "technical_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "requirement", "priority", "owner_department", "evidence", "confidence"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["燃烧性能", "排放环保", "电仪控制", "材料制造", "检验试验", "防爆安全", "资料交付", "其他"]
          },
          "requirement": { "type": "string" },
          "priority": { "type": "string", "enum": ["高", "中", "低"] },
          "owner_department": { "type": "string" },
          "evidence": { "type": "string", "description": "Quoted or paraphrased source span." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_days", "milestones", "installation_and_commissioning"],
      "properties": {
        "delivery_days": { "type": ["integer", "null"] },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "date_or_offset", "owner", "evidence"],
            "properties": {
              "name": { "type": "string" },
              "date_or_offset": { "type": "string" },
              "owner": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "installation_and_commissioning": { "type": ["string", "null"] }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_respond_items", "deviation_items", "missing_items"],
      "properties": {
        "must_respond_items": { "type": "array", "items": { "type": "string" } },
        "deviation_items": { "type": "array", "items": { "type": "string" } },
        "missing_items": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "title", "impact", "mitigation", "owner_department", "evidence"],
        "properties": {
          "level": { "type": "string", "enum": ["高", "中", "低"] },
          "title": { "type": "string" },
          "impact": { "type": "string" },
          "mitigation": { "type": "string" },
          "owner_department": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "outsourcing_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_name", "scope", "reason", "deliverables", "recommended_supplier_type"],
        "properties": {
          "package_name": { "type": "string" },
          "scope": { "type": "string" },
          "reason": { "type": "string" },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "recommended_supplier_type": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executive_summary", "sales_focus", "technical_focus", "project_focus"],
      "properties": {
        "executive_summary": { "type": "array", "items": { "type": "string" } },
        "sales_focus": { "type": "array", "items": { "type": "string" } },
        "technical_focus": { "type": "array", "items": { "type": "string" } },
        "project_focus": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "page", "text"],
        "properties": {
          "section": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "text": { "type": "string" }
        }
      }
    }
  }
}
